# 복사해서 .env 로 만든 뒤 값을 채운다. .env 는 공유·커밋하지 않는다.
DB_PASSWORD=change-me
RECORDINGS_HOST_DIR=./recordings
# 직접 설치(docker 없이)할 때만 아래 두 줄을 쓴다. docker 는 compose 가 넣어 준다.
# DATABASE_URL=postgresql://callcenter:비밀번호@localhost:5432/callcenter
# STORAGE_DIR=./recordings
MAX_UPLOAD_MB=100
ALLOWED_EXT=wav,mp3,m4a
CONFIDENCE_THRESHOLD=0.7
CORS_ORIGINS=*
API_KEY=
CHAT_AI_ENABLED=false
CHAT_AI_API_KEY=
CHAT_AI_BASE_URL=https://api.groq.com/openai/v1
CHAT_AI_MODEL=llama-3.3-70b-versatile
CHAT_AI_TIMEOUT_SEC=8
# Job 시작에 넘기는 음성·결과 주소의 서버 주소(봇 PC가 접속하는 주소). 예: http://192.168.0.10:8000
PUBLIC_BASE_URL=http://localhost:8000
ORCH_ENABLED=false
ORCH_BASE_URL=https://cloud.uipath.com/rpazmlwstb/DefaultTenant/orchestrator_
ORCH_IDENTITY_URL=https://cloud.uipath.com/identity_
ORCH_CLIENT_ID=
ORCH_CLIENT_SECRET=
ORCH_SCOPE=OR.Jobs OR.Execution OR.Folders OR.Machines
ORCH_FOLDER_ID=916682
ORCH_RELEASE_KEY=
ORCH_START_STRATEGY=ModernJobsCount
ORCH_TIMEOUT_MIN=30
