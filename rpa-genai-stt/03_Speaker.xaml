  <Sequence DisplayName="03_Speaker: 화자 나누기와 대화 전문 만들기" sap2010:Annotation.AnnotationText="STT 응답에서 상담원과 고객을 구분해 대화 전문, 확신도, 통화 길이를 만든다. ①응답 읽기 ②상담원 찾기 ③대화 만들기 ④확신도·길이."><Sequence.Variables><Variable x:TypeArguments="njl:JObject" Name="jo_root" /><Variable x:TypeArguments="njl:JArray" Name="jarr_segs" /><Variable x:TypeArguments="x:String" Name="str_agentLabel" /><Variable x:TypeArguments="x:String" Name="str_lastLabel" /><Variable x:TypeArguments="x:String" Name="str_t" /><Variable x:TypeArguments="x:String" Name="str_lb" /></Sequence.Variables><Sequence DisplayName="① 응답 읽기" sap2010:Annotation.AnnotationText="STT 응답 JSON 에서 발화 목록(segments)을 꺼내고 출력값을 비운다."><Assign DisplayName="Assign: jo_root 파싱" sap2010:Annotation.AnnotationText="STT 응답 문자열을 JSON 객체로 바꾼다."><Assign.To><OutArgument x:TypeArguments="njl:JObject">[jo_root]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="njl:JObject">[Newtonsoft.Json.Linq.JObject.Parse(in_sttResponse)]</InArgument></Assign.Value></Assign><Assign DisplayName="Assign: jarr_segs 꺼내기" sap2010:Annotation.AnnotationText="응답의 segments(발화 목록)를 배열로 꺼낸다."><Assign.To><OutArgument x:TypeArguments="njl:JArray">[jarr_segs]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="njl:JArray">[CType(jo_root(&quot;segments&quot;), Newtonsoft.Json.Linq.JArray)]</InArgument></Assign.Value></Assign><Assign DisplayName="Assign: str_agentLabel 초기화" sap2010:Annotation.AnnotationText="상담원으로 정한 화자 번호. 비어 있으면 아직 못 찾은 것이다."><Assign.To><OutArgument x:TypeArguments="x:String">[str_agentLabel]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[&quot;&quot;]</InArgument></Assign.Value></Assign><Assign DisplayName="Assign: str_lastLabel 초기화" sap2010:Annotation.AnnotationText="직전에 말한 화자. 같은 화자가 이어 말하면 한 줄로 합치기 위함이다."><Assign.To><OutArgument x:TypeArguments="x:String">[str_lastLabel]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[&quot;&quot;]</InArgument></Assign.Value></Assign><Assign DisplayName="Assign: out_transcript 초기화" sap2010:Annotation.AnnotationText="대화 전문을 비운다."><Assign.To><OutArgument x:TypeArguments="x:String">[out_transcript]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[&quot;&quot;]</InArgument></Assign.Value></Assign></Sequence><Sequence DisplayName="② 상담원 화자 찾기" sap2010:Annotation.AnnotationText="센터 말투 → 담당자 이름 → 첫 발화자 순서로 상담원 화자를 정한다."><ForEach x:TypeArguments="njl:JToken" DisplayName="For Each: 센터 말투 찾기" sap2010:Annotation.AnnotationText="발화를 처음부터 보며 센터 말투가 있는 첫 발화의 화자를 찾는다." Values="[jarr_segs]"><ActivityAction x:TypeArguments="njl:JToken"><ActivityAction.Argument><DelegateInArgument x:TypeArguments="njl:JToken" Name="seg" /></ActivityAction.Argument><If Condition="[str_agentLabel = &quot;&quot; AndAlso System.Text.RegularExpressions.Regex.IsMatch(seg(&quot;text&quot;).ToString(), &quot;고객센터|고객 지원|지원 센터|상담|무엇을 도와&quot;)]" DisplayName="If: 아직 못 찾았고 센터 말투인가" sap2010:Annotation.AnnotationText="못 찾은 상태에서 &quot;고객센터·상담·무엇을 도와&quot; 등이 들어 있으면 그 화자가 상담원이다."><If.Then><Assign DisplayName="Assign: str_agentLabel = 센터 말투 화자" sap2010:Annotation.AnnotationText="이 발화의 화자 번호를 상담원으로 정한다."><Assign.To><OutArgument x:TypeArguments="x:String">[str_agentLabel]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[seg(&quot;speaker&quot;)(&quot;label&quot;).ToString()]</InArgument></Assign.Value></Assign></If.Then></If></ActivityAction></ForEach><If Condition="[str_agentLabel = &quot;&quot; AndAlso in_agentName &lt;&gt; &quot;미확인&quot;]" DisplayName="If: 담당자 이름으로 찾을까" sap2010:Annotation.AnnotationText="센터 말투로 못 찾았고 담당자 이름이 &quot;미확인&quot;이 아니면, 그 이름을 말한 화자를 찾는다."><If.Then><ForEach x:TypeArguments="njl:JToken" DisplayName="For Each: 담당자 이름 찾기" sap2010:Annotation.AnnotationText="담당자 이름이 들어 있는 첫 발화의 화자를 찾는다." Values="[jarr_segs]"><ActivityAction x:TypeArguments="njl:JToken"><ActivityAction.Argument><DelegateInArgument x:TypeArguments="njl:JToken" Name="seg" /></ActivityAction.Argument><If Condition="[str_agentLabel = &quot;&quot; AndAlso seg(&quot;text&quot;).ToString().Contains(in_agentName)]" DisplayName="If: 아직 못 찾았고 이름이 있는가" sap2010:Annotation.AnnotationText="못 찾은 상태에서 발화에 담당자 이름이 들어 있으면 그 화자가 상담원이다."><If.Then><Assign DisplayName="Assign: str_agentLabel = 이름 말한 화자" sap2010:Annotation.AnnotationText="이 발화의 화자 번호를 상담원으로 정한다."><Assign.To><OutArgument x:TypeArguments="x:String">[str_agentLabel]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[seg(&quot;speaker&quot;)(&quot;label&quot;).ToString()]</InArgument></Assign.Value></Assign></If.Then></If></ActivityAction></ForEach></If.Then></If><If Condition="[str_agentLabel = &quot;&quot; AndAlso jarr_segs.Count &gt; 0]" DisplayName="If: 첫 발화자로 정할까" sap2010:Annotation.AnnotationText="그래도 못 찾았고 발화가 있으면 첫 발화자를 상담원으로 본다."><If.Then><Assign DisplayName="Assign: str_agentLabel = 첫 발화자" sap2010:Annotation.AnnotationText="첫 발화의 화자 번호를 상담원으로 정한다."><Assign.To><OutArgument x:TypeArguments="x:String">[str_agentLabel]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[jarr_segs(0)(&quot;speaker&quot;)(&quot;label&quot;).ToString()]</InArgument></Assign.Value></Assign></If.Then></If></Sequence><Sequence DisplayName="③ 대화 전문 만들기" sap2010:Annotation.AnnotationText="발화를 순서대로 읽어 &quot;[상담원] ...&quot; &quot;[고객] ...&quot; 줄로 이어 붙인다."><ForEach x:TypeArguments="njl:JToken" DisplayName="For Each: 발화 순회" sap2010:Annotation.AnnotationText="발화 목록을 처음부터 끝까지 한 개씩 처리한다." Values="[jarr_segs]"><ActivityAction x:TypeArguments="njl:JToken"><ActivityAction.Argument><DelegateInArgument x:TypeArguments="njl:JToken" Name="seg" /></ActivityAction.Argument><Sequence DisplayName="발화 1개 처리" sap2010:Annotation.AnnotationText="빈 발화는 건너뛰고, 같은 화자가 이어 말하면 앞 줄에 붙이고, 화자가 바뀌면 새 줄을 시작한다."><Assign DisplayName="Assign: str_t 발화 글" sap2010:Annotation.AnnotationText="발화 글의 앞뒤 공백을 지운다."><Assign.To><OutArgument x:TypeArguments="x:String">[str_t]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[seg(&quot;text&quot;).ToString().Trim()]</InArgument></Assign.Value></Assign><If Condition="[str_t &lt;&gt; &quot;&quot;]" DisplayName="If: 발화 글이 있는가" sap2010:Annotation.AnnotationText="빈 발화는 건너뛴다."><If.Then><Sequence DisplayName="줄 만들기" sap2010:Annotation.AnnotationText="화자를 확인해 앞 줄에 붙이거나 새 줄을 만든다."><Assign DisplayName="Assign: str_lb 화자" sap2010:Annotation.AnnotationText="이 발화의 화자 번호."><Assign.To><OutArgument x:TypeArguments="x:String">[str_lb]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[seg(&quot;speaker&quot;)(&quot;label&quot;).ToString()]</InArgument></Assign.Value></Assign><If Condition="[str_lb = str_lastLabel]" DisplayName="If: 직전과 같은 화자인가" sap2010:Annotation.AnnotationText="같으면 앞 줄 끝에 공백과 함께 붙이고, 다르면 새 줄을 시작한다."><If.Then><Assign DisplayName="Assign: 앞 줄에 이어 붙이기" sap2010:Annotation.AnnotationText="같은 화자가 이어 말했으므로 한 줄로 합친다."><Assign.To><OutArgument x:TypeArguments="x:String">[out_transcript]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[out_transcript + &quot; &quot; + str_t]</InArgument></Assign.Value></Assign></If.Then><If.Else><Assign DisplayName="Assign: 새 줄 추가" sap2010:Annotation.AnnotationText="줄바꿈 뒤에 [상담원] 또는 [고객] 표시를 붙여 새 줄을 만든다."><Assign.To><OutArgument x:TypeArguments="x:String">[out_transcript]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[out_transcript + If(out_transcript = &quot;&quot;, &quot;&quot;, vbLf) + If(str_lb = str_agentLabel, &quot;[상담원] &quot;, &quot;[고객] &quot;) + str_t]</InArgument></Assign.Value></Assign></If.Else></If><Assign DisplayName="Assign: str_lastLabel 갱신" sap2010:Annotation.AnnotationText="직전 화자를 이 화자로 바꾼다."><Assign.To><OutArgument x:TypeArguments="x:String">[str_lastLabel]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[str_lb]</InArgument></Assign.Value></Assign></Sequence></If.Then></If></Sequence></ActivityAction></ForEach></Sequence><Sequence DisplayName="④ 확신도와 통화 길이" sap2010:Annotation.AnnotationText="STT 확신도와 통화 길이(초)를 출력 인자에 담는다."><Assign DisplayName="Assign: out_confidence" sap2010:Annotation.AnnotationText="STT 응답의 확신도."><Assign.To><OutArgument x:TypeArguments="x:Double">[out_confidence]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Double">[jo_root(&quot;confidence&quot;).ToObject(Of Double)()]</InArgument></Assign.Value></Assign><Assign DisplayName="Assign: out_durationSec" sap2010:Annotation.AnnotationText="마지막 발화의 끝 시각(ms)을 초로 바꾼다. 발화가 없으면 0."><Assign.To><OutArgument x:TypeArguments="x:Int32">[out_durationSec]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Int32">[If(jarr_segs.Count &gt; 0, CInt(jarr_segs(jarr_segs.Count - 1)(&quot;end&quot;).ToObject(Of Integer)() / 1000.0), 0)]</InArgument></Assign.Value></Assign></Sequence></Sequence>
