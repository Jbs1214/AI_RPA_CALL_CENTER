    <ui:InvokeCode ContinueOnError="{x:Null}" Code="Dim root As Newtonsoft.Json.Linq.JObject = Newtonsoft.Json.Linq.JObject.Parse(sttResponse)&#xA;Dim segs = root(&quot;segments&quot;).ToList()&#xA;&#xA;' 1) 상담원 화자 찾기: 센터 말투가 있는 첫 발화의 화자&#xA;Dim agentLabel As String = &quot;&quot;&#xA;Dim hit = segs.FirstOrDefault(Function(s) System.Text.RegularExpressions.Regex.IsMatch(s(&quot;text&quot;).ToString(), &quot;고객센터|고객 지원|지원 센터|상담|무엇을 도와&quot;))&#xA;If hit IsNot Nothing Then&#xA;    agentLabel = hit(&quot;speaker&quot;)(&quot;label&quot;).ToString()&#xA;ElseIf agentName &lt;&gt; &quot;미확인&quot; Then&#xA;    ' 2) 담당자 이름을 말한 화자&#xA;    hit = segs.FirstOrDefault(Function(s) s(&quot;text&quot;).ToString().Contains(agentName))&#xA;    If hit IsNot Nothing Then agentLabel = hit(&quot;speaker&quot;)(&quot;label&quot;).ToString()&#xA;End If&#xA;' 3) 그래도 못 찾으면 첫 발화자&#xA;If agentLabel = &quot;&quot; AndAlso segs.Count &gt; 0 Then agentLabel = segs(0)(&quot;speaker&quot;)(&quot;label&quot;).ToString()&#xA;&#xA;' 같은 화자가 연속으로 말하면 한 줄로 합치기&#xA;Dim lines As New List(Of String)&#xA;Dim lastLabel As String = Nothing&#xA;For Each s In segs&#xA;    Dim t As String = s(&quot;text&quot;).ToString().Trim()&#xA;    If t = &quot;&quot; Then Continue For&#xA;    Dim lb As String = s(&quot;speaker&quot;)(&quot;label&quot;).ToString()&#xA;    If lb = lastLabel Then&#xA;        lines(lines.Count - 1) = lines(lines.Count - 1) + &quot; &quot; + t&#xA;    Else&#xA;        lines.Add(If(lb = agentLabel, &quot;[상담원] &quot;, &quot;[고객] &quot;) + t)&#xA;        lastLabel = lb&#xA;    End If&#xA;Next&#xA;transcript = String.Join(vbLf, lines)&#xA;&#xA;confidence = root(&quot;confidence&quot;).ToObject(Of Double)()&#xA;durationSec = If(segs.Count &gt; 0, CInt(segs(segs.Count - 1)(&quot;end&quot;).ToObject(Of Integer)() / 1000.0), 0)" DisplayName="Invoke Code" sap:VirtualizedContainerService.HintSize="450,394" sap2010:WorkflowViewState.IdRef="InvokeCode_1">
