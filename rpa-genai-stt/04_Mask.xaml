    <ui:InvokeCode ContinueOnError="{x:Null}" Code="Dim t As String = If(transcript Is Nothing, &quot;&quot;, transcript)&#xA;' 0) 한글로 읽은 숫자 (공일공 공공공공 칠칠삼삼 등): 숫자 9개 이상 이어지면 숫자로 바꿔서 가림&#xA;Dim digitMap As New Dictionary(Of Char, Char) From {&#xA;    {&quot;공&quot;c, &quot;0&quot;c}, {&quot;영&quot;c, &quot;0&quot;c}, {&quot;일&quot;c, &quot;1&quot;c}, {&quot;이&quot;c, &quot;2&quot;c}, {&quot;삼&quot;c, &quot;3&quot;c}, {&quot;사&quot;c, &quot;4&quot;c},&#xA;    {&quot;오&quot;c, &quot;5&quot;c}, {&quot;육&quot;c, &quot;6&quot;c}, {&quot;륙&quot;c, &quot;6&quot;c}, {&quot;칠&quot;c, &quot;7&quot;c}, {&quot;팔&quot;c, &quot;8&quot;c}, {&quot;구&quot;c, &quot;9&quot;c}}&#xA;Dim digitClass As String = &quot;[공영일이삼사오육륙칠팔구0-9]&quot;&#xA;t = System.Text.RegularExpressions.Regex.Replace(t, &quot;(?:&quot; + digitClass + &quot;[\s\-.,]*){8,}&quot; + digitClass,&#xA;    Function(m As System.Text.RegularExpressions.Match) As String&#xA;        Dim sb As New System.Text.StringBuilder()&#xA;        Dim cut As Integer = -1&#xA;        For i As Integer = 0 To m.Value.Length - 1&#xA;            Dim ch As Char = m.Value(i)&#xA;            If Char.IsDigit(ch) Then&#xA;                sb.Append(ch)&#xA;            ElseIf digitMap.ContainsKey(ch) Then&#xA;                sb.Append(digitMap(ch))&#xA;            End If&#xA;            If cut &lt; 0 AndAlso sb.Length = 11 Then cut = i + 1&#xA;        Next&#xA;        Dim d As String = sb.ToString()&#xA;        Dim rest As String = &quot;&quot;&#xA;        ' 0으로 시작하는데 12자리 이상이면 뒤에 붙은 조사(예: 칠칠삼삼&quot;이&quot;에요)까지 잡힌 것: 11자리만 번호로 보고 나머지는 원문 그대로&#xA;        If d.StartsWith(&quot;0&quot;) AndAlso d.Length &gt; 11 AndAlso cut &gt; 0 Then&#xA;            rest = m.Value.Substring(cut)&#xA;            d = d.Substring(0, 11)&#xA;        End If&#xA;        Dim n As Integer = d.Length&#xA;        If n = 13 AndAlso &quot;1234&quot;.Contains(d(6)) Then Return d.Substring(0, 6) + &quot;-*******&quot;&#xA;        If d.StartsWith(&quot;0&quot;) AndAlso (n = 10 OrElse n = 11) Then&#xA;            Dim pre As String = If(d.StartsWith(&quot;02&quot;), &quot;02&quot;, d.Substring(0, 3))&#xA;            Return pre + &quot;-****-&quot; + d.Substring(n - 4) + rest&#xA;        End If&#xA;        Return New String(&quot;*&quot;c, n - 4) + d.Substring(n - 4) + rest&#xA;    End Function)&#xA;' 1) 주민등록번호 형태: 앞 6자리는 두고 뒤 7자리를 가림 (전화번호보다 먼저 처리)&#xA;t = System.Text.RegularExpressions.Regex.Replace(t, &quot;(?&lt;!\d)(\d{6})[-\s]?[1-4]\d{6}(?!\d)&quot;, &quot;$1-*******&quot;)&#xA;' 2) 전화번호: 가운데 자리를 가림&#xA;t = System.Text.RegularExpressions.Regex.Replace(t, &quot;(?&lt;!\d)(0\d{1,2})[-.\s]?\d{3,4}[-.\s]?(\d{4})(?!\d)&quot;, &quot;$1-****-$2&quot;)&#xA;' 3) 이메일: 첫 글자만 남기고 가림&#xA;t = System.Text.RegularExpressions.Regex.Replace(t, &quot;([A-Za-z0-9._%+-])[A-Za-z0-9._%+-]*@([A-Za-z0-9-]+(\.[A-Za-z0-9-]+)+)&quot;, &quot;$1***@$2&quot;)&#xA;maskedTranscript = t&#xA;" DisplayName="Invoke Code: 한글 숫자, 주민번호, 전화번호, 이메일 가리기" sap:VirtualizedContainerService.HintSize="450,394" sap2010:WorkflowViewState.IdRef="InvokeCode_1">
