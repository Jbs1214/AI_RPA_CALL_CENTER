  <Sequence DisplayName="04_Mask: 개인정보 가리기" sap2010:Annotation.AnnotationText="대화 전문에서 전화번호·주민번호·이메일(한글로 읽은 숫자 포함)을 가린다. ①준비 ②한글 숫자 ③정규식 ④내보내기."><Sequence.Variables><Variable x:TypeArguments="x:String" Name="str_t" /></Sequence.Variables><Sequence DisplayName="① 준비" sap2010:Annotation.AnnotationText="입력 대화를 작업용 변수에 복사한다. 입력이 없으면 빈 문자열로 둔다."><Assign DisplayName="Assign: str_t 복사" sap2010:Annotation.AnnotationText="마스킹할 대화 전문. Nothing 이면 빈 문자열."><Assign.To><OutArgument x:TypeArguments="x:String">[str_t]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[If(in_transcript Is Nothing, &quot;&quot;, in_transcript)]</InArgument></Assign.Value></Assign></Sequence><Sequence DisplayName="② 한글로 읽은 숫자 가리기" sap2010:Annotation.AnnotationText="&quot;공일공 칠칠삼삼…&quot;처럼 한글로 읽은 번호를 숫자로 바꿔 가린다. 숫자가 9개 이상 이어질 때만 대상이다."><ForEach x:TypeArguments="sr:Match" DisplayName="For Each: 숫자열 순회" sap2010:Annotation.AnnotationText="숫자열을 뒤에서부터 한 개씩 처리한다. 뒤에서부터 바꿔야 앞쪽 위치가 밀리지 않는다." Values="[System.Text.RegularExpressions.Regex.Matches(str_t, &quot;(?:[공영일이삼사오육륙칠팔구0-9][\s\-.,]*){8,}[공영일이삼사오육륙칠팔구0-9]&quot;).Cast(Of System.Text.RegularExpressions.Match)().OrderByDescending(Function(x) x.Index).ToList()]"><ActivityAction x:TypeArguments="sr:Match"><ActivityAction.Argument><DelegateInArgument x:TypeArguments="sr:Match" Name="m" /></ActivityAction.Argument><Sequence DisplayName="숫자열 1개 처리" sap2010:Annotation.AnnotationText="찾은 숫자열을 숫자로 바꾼 뒤 자리 수에 따라 주민번호·전화번호·그 밖의 숫자로 나눠 가린다."><Sequence.Variables><Variable x:TypeArguments="x:String" Name="str_d" /><Variable x:TypeArguments="x:String" Name="str_rest" /><Variable x:TypeArguments="x:String" Name="str_masked" /><Variable x:TypeArguments="x:String" Name="str_c" /><Variable x:TypeArguments="x:Int32" Name="int_cnt" /><Variable x:TypeArguments="x:Int32" Name="int_cut" /><Variable x:TypeArguments="x:Int32" Name="int_pos" /><Variable x:TypeArguments="x:Int32" Name="int_n" /></Sequence.Variables><Assign DisplayName="Assign: str_d 초기화" sap2010:Annotation.AnnotationText="한글·숫자를 아라비아 숫자로 바꾼 결과를 담는다."><Assign.To><OutArgument x:TypeArguments="x:String">[str_d]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[&quot;&quot;]</InArgument></Assign.Value></Assign><Assign DisplayName="Assign: int_cnt 초기화" sap2010:Annotation.AnnotationText="지금까지 숫자로 바꾼 글자 수."><Assign.To><OutArgument x:TypeArguments="x:Int32">[int_cnt]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Int32">[0]</InArgument></Assign.Value></Assign><Assign DisplayName="Assign: int_cut 초기화" sap2010:Annotation.AnnotationText="11번째 숫자가 나온 위치. 아직 없으면 -1."><Assign.To><OutArgument x:TypeArguments="x:Int32">[int_cut]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Int32">[-1]</InArgument></Assign.Value></Assign><Assign DisplayName="Assign: int_pos 초기화" sap2010:Annotation.AnnotationText="숫자열 안에서 지금 보는 글자 위치."><Assign.To><OutArgument x:TypeArguments="x:Int32">[int_pos]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Int32">[0]</InArgument></Assign.Value></Assign><ForEach x:TypeArguments="x:Char" DisplayName="For Each: 글자 순회" sap2010:Annotation.AnnotationText="숫자열을 한 글자씩 보며 숫자로 바꾼다. 공백·하이픈 등은 버린다." Values="[m.Value.ToCharArray()]"><ActivityAction x:TypeArguments="x:Char"><ActivityAction.Argument><DelegateInArgument x:TypeArguments="x:Char" Name="ch" /></ActivityAction.Argument><Sequence DisplayName="글자 1개 처리" sap2010:Annotation.AnnotationText="한글 숫자(공=0, 일=1 …)나 아라비아 숫자면 str_d 에 붙인다."><Assign DisplayName="Assign: str_c 글자 변환" sap2010:Annotation.AnnotationText="아라비아 숫자는 그대로, 한글 숫자는 숫자로 바꾼다. 그 외 글자는 빈 값."><Assign.To><OutArgument x:TypeArguments="x:String">[str_c]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[If(Char.IsDigit(ch), ch.ToString(), If(&quot;공영일이삼사오육륙칠팔구&quot;.IndexOf(ch) &gt;= 0, &quot;001234566789&quot;.Substring(&quot;공영일이삼사오육륙칠팔구&quot;.IndexOf(ch), 1), &quot;&quot;))]</InArgument></Assign.Value></Assign><If Condition="[str_c &lt;&gt; &quot;&quot;]" DisplayName="If: 숫자로 바뀐 글자인가" sap2010:Annotation.AnnotationText="숫자가 된 글자만 세고 이어 붙인다."><If.Then><Sequence DisplayName="숫자 붙이기" sap2010:Annotation.AnnotationText="숫자를 이어 붙이고, 11번째 숫자 위치를 기억한다."><Assign DisplayName="Assign: str_d 이어 붙이기" sap2010:Annotation.AnnotationText="변환한 숫자를 뒤에 붙인다."><Assign.To><OutArgument x:TypeArguments="x:String">[str_d]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[str_d + str_c]</InArgument></Assign.Value></Assign><Assign DisplayName="Assign: int_cnt + 1" sap2010:Annotation.AnnotationText="숫자 개수를 1 올린다."><Assign.To><OutArgument x:TypeArguments="x:Int32">[int_cnt]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Int32">[int_cnt + 1]</InArgument></Assign.Value></Assign><If Condition="[int_cut &lt; 0 AndAlso int_cnt = 11]" DisplayName="If: 11번째 숫자인가" sap2010:Annotation.AnnotationText="처음으로 숫자가 11개가 된 위치를 기억한다. 뒤에 붙은 조사를 떼어 내는 데 쓴다."><If.Then><Assign DisplayName="Assign: int_cut 기억" sap2010:Annotation.AnnotationText="11번째 숫자 바로 뒤 위치."><Assign.To><OutArgument x:TypeArguments="x:Int32">[int_cut]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Int32">[int_pos + 1]</InArgument></Assign.Value></Assign></If.Then></If></Sequence></If.Then></If><Assign DisplayName="Assign: int_pos + 1" sap2010:Annotation.AnnotationText="다음 글자 위치로 간다."><Assign.To><OutArgument x:TypeArguments="x:Int32">[int_pos]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Int32">[int_pos + 1]</InArgument></Assign.Value></Assign></Sequence></ActivityAction></ForEach><Assign DisplayName="Assign: str_rest 초기화" sap2010:Annotation.AnnotationText="번호 뒤에 붙은 조사 등 원문 그대로 둘 부분."><Assign.To><OutArgument x:TypeArguments="x:String">[str_rest]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[&quot;&quot;]</InArgument></Assign.Value></Assign><If Condition="[str_d.StartsWith(&quot;0&quot;) AndAlso str_d.Length &gt; 11 AndAlso int_cut &gt; 0]" DisplayName="If: 0으로 시작하는데 11자리를 넘는가" sap2010:Annotation.AnnotationText="번호 뒤에 붙은 조사(예: 칠칠삼삼&quot;이&quot;에요)까지 잡힌 경우다. 11자리만 번호로 보고 나머지는 원문 그대로 둔다."><If.Then><Sequence DisplayName="11자리로 자르기" sap2010:Annotation.AnnotationText="번호 11자리와 나머지를 나눈다."><Assign DisplayName="Assign: str_rest 나머지" sap2010:Annotation.AnnotationText="11번째 숫자 뒤의 원문."><Assign.To><OutArgument x:TypeArguments="x:String">[str_rest]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[m.Value.Substring(int_cut)]</InArgument></Assign.Value></Assign><Assign DisplayName="Assign: str_d 11자리" sap2010:Annotation.AnnotationText="앞 11자리만 번호로 쓴다."><Assign.To><OutArgument x:TypeArguments="x:String">[str_d]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[str_d.Substring(0, 11)]</InArgument></Assign.Value></Assign></Sequence></If.Then></If><Assign DisplayName="Assign: int_n 자리 수" sap2010:Annotation.AnnotationText="번호로 본 숫자의 자리 수."><Assign.To><OutArgument x:TypeArguments="x:Int32">[int_n]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Int32">[str_d.Length]</InArgument></Assign.Value></Assign><If Condition="[int_n = 13 AndAlso &quot;1234&quot;.Contains(str_d(6))]" DisplayName="If: 13자리 주민번호인가" sap2010:Annotation.AnnotationText="13자리이고 7번째 숫자가 1~4면 주민번호다. 앞 6자리만 남기고 가린다."><If.Then><Assign DisplayName="Assign: 주민번호 마스킹" sap2010:Annotation.AnnotationText="앞 6자리 뒤에 -******* 를 붙인다."><Assign.To><OutArgument x:TypeArguments="x:String">[str_masked]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[str_d.Substring(0, 6) + &quot;-*******&quot;]</InArgument></Assign.Value></Assign></If.Then><If.Else><If Condition="[str_d.StartsWith(&quot;0&quot;) AndAlso (int_n = 10 OrElse int_n = 11)]" DisplayName="If: 10~11자리 전화번호인가" sap2010:Annotation.AnnotationText="0으로 시작하고 10 또는 11자리면 전화번호다. 가운데를 가리고 뒤 4자리를 남긴다."><If.Then><Assign DisplayName="Assign: 전화번호 마스킹" sap2010:Annotation.AnnotationText="앞자리(02 또는 3자리)-****-뒤 4자리, 그 뒤에 조사 등 나머지를 붙인다."><Assign.To><OutArgument x:TypeArguments="x:String">[str_masked]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[If(str_d.StartsWith(&quot;02&quot;), &quot;02&quot;, str_d.Substring(0, 3)) + &quot;-****-&quot; + str_d.Substring(int_n - 4) + str_rest]</InArgument></Assign.Value></Assign></If.Then><If.Else><Assign DisplayName="Assign: 그 밖의 숫자 마스킹" sap2010:Annotation.AnnotationText="앞은 *, 뒤 4자리만 남긴다. 조사 등 나머지는 그대로 붙인다."><Assign.To><OutArgument x:TypeArguments="x:String">[str_masked]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[New String(&quot;*&quot;c, int_n - 4) + str_d.Substring(int_n - 4) + str_rest]</InArgument></Assign.Value></Assign></If.Else></If></If.Else></If><Assign DisplayName="Assign: str_t 제자리 바꾸기" sap2010:Annotation.AnnotationText="찾은 위치(Index, Length)의 원문을 가린 결과로 바꾼다. 뒤에서부터 바꾸므로 앞 위치가 밀리지 않는다."><Assign.To><OutArgument x:TypeArguments="x:String">[str_t]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[str_t.Remove(m.Index, m.Length).Insert(m.Index, str_masked)]</InArgument></Assign.Value></Assign></Sequence></ActivityAction></ForEach></Sequence><Sequence DisplayName="③ 주민번호·전화번호·이메일 가리기" sap2010:Annotation.AnnotationText="정규식으로 형태가 뚜렷한 개인정보를 가린다. 주민번호를 전화번호보다 먼저 처리한다."><Assign DisplayName="Assign: 주민번호 가리기" sap2010:Annotation.AnnotationText="앞 6자리는 두고 뒤 7자리를 *로 가린다. (전화번호보다 먼저 처리)"><Assign.To><OutArgument x:TypeArguments="x:String">[str_t]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[System.Text.RegularExpressions.Regex.Replace(str_t, &quot;(?&lt;!\d)(\d{6})[-\s]?[1-4]\d{6}(?!\d)&quot;, &quot;$1-*******&quot;)]</InArgument></Assign.Value></Assign><Assign DisplayName="Assign: 전화번호 가리기" sap2010:Annotation.AnnotationText="가운데 자리를 ****로 가리고 앞자리와 뒤 4자리를 남긴다."><Assign.To><OutArgument x:TypeArguments="x:String">[str_t]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[System.Text.RegularExpressions.Regex.Replace(str_t, &quot;(?&lt;!\d)(0\d{1,2})[-.\s]?\d{3,4}[-.\s]?(\d{4})(?!\d)&quot;, &quot;$1-****-$2&quot;)]</InArgument></Assign.Value></Assign><Assign DisplayName="Assign: 이메일 가리기" sap2010:Annotation.AnnotationText="첫 글자만 남기고 *** 로 가린다. 도메인은 그대로 둔다."><Assign.To><OutArgument x:TypeArguments="x:String">[str_t]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[System.Text.RegularExpressions.Regex.Replace(str_t, &quot;([A-Za-z0-9._%+-])[A-Za-z0-9._%+-]*@([A-Za-z0-9-]+(\.[A-Za-z0-9-]+)+)&quot;, &quot;$1***@$2&quot;)]</InArgument></Assign.Value></Assign></Sequence><Sequence DisplayName="④ 결과 내보내기" sap2010:Annotation.AnnotationText="가린 대화를 출력 인자에 담는다."><Assign DisplayName="Assign: out_maskedTranscript" sap2010:Annotation.AnnotationText="마스킹이 끝난 대화 전문."><Assign.To><OutArgument x:TypeArguments="x:String">[out_maskedTranscript]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[str_t]</InArgument></Assign.Value></Assign><ui:LogMessage DisplayName="Log Message: 마스킹 완료" sap2010:Annotation.AnnotationText="글자 수만 남긴다. 대화 내용은 개인정보가 있을 수 있어 찍지 않는다." Level="Info" Message="[&quot;04_Mask: 마스킹 완료, 길이=&quot; + out_maskedTranscript.Length.ToString()]" /></Sequence></Sequence>
</Activity>