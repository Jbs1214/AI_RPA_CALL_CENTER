  <Sequence DisplayName="06_Save: 백엔드에 통화 결과 저장" sap2010:Annotation.AnnotationText="통화 1건 결과를 POST /api/calls 로 서버에 저장한다. ①초기화 ②공통 필드 ③본문 조립 ④직렬화 ⑤전송 순서."><Sequence.Variables><Variable x:TypeArguments="scg:Dictionary(x:String, x:Object)" Name="dict_body" /><Variable x:TypeArguments="njl:JObject" Name="jo_analysis" /><Variable x:TypeArguments="x:String" Name="str_errorMessage" /><Variable x:TypeArguments="x:String" Name="str_body" /><Variable x:TypeArguments="uwahm:HttpResponseSummary" Name="httpRes" /></Sequence.Variables><Sequence DisplayName="① 초기화" sap2010:Annotation.AnnotationText="출력값과 요청 본문 딕셔너리를 비운다."><Assign DisplayName="Assign: out_statusCode 초기화" sap2010:Annotation.AnnotationText="상태 코드를 0(미전송)으로 둔다. 전송에 성공하면 서버 응답 코드로 바뀐다."><Assign.To><OutArgument x:TypeArguments="x:Int32">[out_statusCode]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Int32">[0]</InArgument></Assign.Value></Assign><Assign DisplayName="Assign: out_responseBody 초기화" sap2010:Annotation.AnnotationText="응답 본문을 빈 문자열로 둔다."><Assign.To><OutArgument x:TypeArguments="x:String">[out_responseBody]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[&quot;&quot;]</InArgument></Assign.Value></Assign><Assign DisplayName="Assign: dict_body 새로 만들기" sap2010:Annotation.AnnotationText="JSON 으로 바꿀 요청 본문을 담을 빈 딕셔너리를 만든다."><Assign.To><OutArgument x:TypeArguments="scg:Dictionary(x:String, x:Object)">[dict_body]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="scg:Dictionary(x:String, x:Object)">[New Dictionary(Of String, Object)()]</InArgument></Assign.Value></Assign><Assign DisplayName="Assign: jo_analysis 새로 만들기" sap2010:Annotation.AnnotationText="AI 분석 결과를 담을 빈 JSON 객체를 만든다. 파싱에 실패해도 빈 객체로 남는다."><Assign.To><OutArgument x:TypeArguments="njl:JObject">[jo_analysis]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="njl:JObject">[New Newtonsoft.Json.Linq.JObject()]</InArgument></Assign.Value></Assign><Assign DisplayName="Assign: str_errorMessage 복사" sap2010:Annotation.AnnotationText="실패 사유 인자를 지역 변수로 복사한다. 비어 있으면 아래에서 기본값을 넣기 위함이다."><Assign.To><OutArgument x:TypeArguments="x:String">[str_errorMessage]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[in_errorMessage]</InArgument></Assign.Value></Assign></Sequence><Sequence DisplayName="② 공통 필드 채우기" sap2010:Annotation.AnnotationText="SUCCESS 와 FAILED 모두에 들어가는 6개 필드를 채운다."><Assign DisplayName="Assign: called_at" sap2010:Annotation.AnnotationText="통화 시각."><Assign.To><OutArgument x:TypeArguments="x:Object">[dict_body(&quot;called_at&quot;)]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Object">[in_calledAt]</InArgument></Assign.Value></Assign><Assign DisplayName="Assign: agent_name" sap2010:Annotation.AnnotationText="상담원 이름."><Assign.To><OutArgument x:TypeArguments="x:Object">[dict_body(&quot;agent_name&quot;)]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Object">[in_agentName]</InArgument></Assign.Value></Assign><Assign DisplayName="Assign: customer_company" sap2010:Annotation.AnnotationText="고객 회사명."><Assign.To><OutArgument x:TypeArguments="x:Object">[dict_body(&quot;customer_company&quot;)]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Object">[in_customerCompany]</InArgument></Assign.Value></Assign><Assign DisplayName="Assign: source_filename" sap2010:Annotation.AnnotationText="원본 녹음 파일명."><Assign.To><OutArgument x:TypeArguments="x:Object">[dict_body(&quot;source_filename&quot;)]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Object">[in_sourceFilename]</InArgument></Assign.Value></Assign><Assign DisplayName="Assign: file_hash" sap2010:Annotation.AnnotationText="파일 해시(중복 판별용)."><Assign.To><OutArgument x:TypeArguments="x:Object">[dict_body(&quot;file_hash&quot;)]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Object">[in_fileHash]</InArgument></Assign.Value></Assign><Assign DisplayName="Assign: status" sap2010:Annotation.AnnotationText="처리 결과(SUCCESS 또는 FAILED)."><Assign.To><OutArgument x:TypeArguments="x:Object">[dict_body(&quot;status&quot;)]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Object">[in_status]</InArgument></Assign.Value></Assign></Sequence><Sequence DisplayName="③ 요청 본문 조립" sap2010:Annotation.AnnotationText="status 가 FAILED 인지에 따라 본문 내용을 다르게 채운다."><If Condition="[in_status = &quot;FAILED&quot;]" DisplayName="If: 실패 건인가" sap2010:Annotation.AnnotationText="FAILED 이면 실패 사유만, 아니면 분석 결과 전체를 담는다."><If.Then><Sequence DisplayName="FAILED: 실패 사유만 담기" sap2010:Annotation.AnnotationText="실패 건은 사유만 서버에 남긴다. 분석 필드는 보내지 않는다."><If Condition="[str_errorMessage Is Nothing OrElse str_errorMessage.Trim() = &quot;&quot;]" DisplayName="If: 실패 사유가 비었는가" sap2010:Annotation.AnnotationText="사유가 Nothing 또는 공백이면 &quot;UNKNOWN: 사유 불명&quot;으로 바꿔 서버가 빈 사유를 받지 않게 한다."><If.Then><Assign DisplayName="Assign: 기본 사유 넣기" sap2010:Annotation.AnnotationText="사유가 없을 때 기본 문구를 넣는다."><Assign.To><OutArgument x:TypeArguments="x:String">[str_errorMessage]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[&quot;UNKNOWN: 사유 불명&quot;]</InArgument></Assign.Value></Assign></If.Then></If><Assign DisplayName="Assign: error_message" sap2010:Annotation.AnnotationText="실패 사유."><Assign.To><OutArgument x:TypeArguments="x:Object">[dict_body(&quot;error_message&quot;)]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Object">[str_errorMessage]</InArgument></Assign.Value></Assign></Sequence></If.Then><If.Else><Sequence DisplayName="SUCCESS: 분석 결과 담기" sap2010:Annotation.AnnotationText="성공 건은 대화 전문과 AI 분석 결과를 모두 담는다."><Assign DisplayName="Assign: customer_phone" sap2010:Annotation.AnnotationText="전화번호는 마스킹 단계에서 제거했으므로 항상 null."><Assign.To><OutArgument x:TypeArguments="x:Object">[dict_body(&quot;customer_phone&quot;)]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Object">[Nothing]</InArgument></Assign.Value></Assign><Assign DisplayName="Assign: transcript" sap2010:Annotation.AnnotationText="마스킹된 대화 전문."><Assign.To><OutArgument x:TypeArguments="x:Object">[dict_body(&quot;transcript&quot;)]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Object">[in_transcript]</InArgument></Assign.Value></Assign><Assign DisplayName="Assign: category" sap2010:Annotation.AnnotationText="AI 가 분류한 문의 유형."><Assign.To><OutArgument x:TypeArguments="x:Object">[dict_body(&quot;category&quot;)]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Object">[in_category]</InArgument></Assign.Value></Assign><Assign DisplayName="Assign: customer_question" sap2010:Annotation.AnnotationText="고객 질문 요지."><Assign.To><OutArgument x:TypeArguments="x:Object">[dict_body(&quot;customer_question&quot;)]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Object">[in_customerQuestion]</InArgument></Assign.Value></Assign><Assign DisplayName="Assign: action_taken" sap2010:Annotation.AnnotationText="상담원 조치 내용."><Assign.To><OutArgument x:TypeArguments="x:Object">[dict_body(&quot;action_taken&quot;)]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Object">[in_actionTaken]</InArgument></Assign.Value></Assign><Assign DisplayName="Assign: follow_up_needed" sap2010:Annotation.AnnotationText="후속 조치 필요 여부. 문자열 &quot;true&quot; 일 때만 True."><Assign.To><OutArgument x:TypeArguments="x:Object">[dict_body(&quot;follow_up_needed&quot;)]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Object">[in_followUp = &quot;true&quot;]</InArgument></Assign.Value></Assign><Assign DisplayName="Assign: confidence" sap2010:Annotation.AnnotationText="AI 확신도. 소수 둘째 자리까지 반올림."><Assign.To><OutArgument x:TypeArguments="x:Object">[dict_body(&quot;confidence&quot;)]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Object">[Math.Round(in_confidence, 2)]</InArgument></Assign.Value></Assign><TryCatch DisplayName="Try Catch: AI 응답 JSON 파