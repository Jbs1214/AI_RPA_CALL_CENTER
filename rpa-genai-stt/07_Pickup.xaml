    <ui:InvokeCode ContinueOnError="{x:Null}" Code="callId = &quot;&quot;&#xA;audioPath = &quot;&quot;&#xA;message = &quot;&quot;&#xA;Try&#xA;    Using client As New System.Net.Http.HttpClient()&#xA;        client.Timeout = TimeSpan.FromSeconds(60)&#xA;        client.DefaultRequestHeaders.Add(&quot;X-API-Key&quot;, apiKey)&#xA;        ' 1) 대기 건 목록 (API 2)&#xA;        Dim listResp = client.GetAsync(baseUrl + &quot;/api/calls?status=RECEIVED&quot;).GetAwaiter().GetResult()&#xA;        If CInt(listResp.StatusCode) &lt;&gt; 200 Then&#xA;            message = &quot;LIST_FAILED: &quot; + CInt(listResp.StatusCode).ToString()&#xA;        Else&#xA;            Dim listBody As String = listResp.Content.ReadAsStringAsync().GetAwaiter().GetResult()&#xA;            Dim items = Newtonsoft.Json.Linq.JObject.Parse(listBody)(&quot;items&quot;)&#xA;            If items Is Nothing OrElse items.Count() = 0 Then&#xA;                message = &quot;NO_PENDING&quot;&#xA;            Else&#xA;                ' 2) 가져가기 (API 12): 200이면 내 것, 409면 다음 건&#xA;                For Each it In items&#xA;                    Dim cid As String = it(&quot;call_id&quot;).ToString()&#xA;                    If onlyCallId IsNot Nothing AndAlso onlyCallId &lt;&gt; &quot;&quot; AndAlso cid &lt;&gt; onlyCallId Then Continue For&#xA;                    Dim pr = client.PostAsync(baseUrl + &quot;/api/calls/&quot; + cid + &quot;/process&quot;, New System.Net.Http.StringContent(&quot;&quot;, System.Text.Encoding.UTF8, &quot;application/json&quot;)).GetAwaiter().GetResult()&#xA;                    If CInt(pr.StatusCode) = 200 Then&#xA;                        callId = cid&#xA;                        Exit For&#xA;                    End If&#xA;                Next&#xA;                If callId = &quot;&quot; Then&#xA;                    message = If(onlyCallId IsNot Nothing AndAlso onlyCallId &lt;&gt; &quot;&quot;, &quot;TARGET_NOT_PENDING: &quot; + onlyCallId, &quot;ALL_TAKEN&quot;)&#xA;                Else&#xA;                    ' 3) 음성 받기 (API 10): 실패 시 5초 간격 3회&#xA;                    For attempt As Integer = 1 To 3&#xA;                        Dim ar = client.GetAsync(baseUrl + &quot;/api/calls/&quot; + callId + &quot;/audio&quot;).GetAwaiter().GetResult()&#xA;                        If CInt(ar.StatusCode) = 200 Then&#xA;                            Dim ct As String = &quot;&quot;&#xA;                            If ar.Content.Headers.ContentType IsNot Nothing Then ct = ar.Content.Headers.ContentType.MediaType.ToLower()&#xA;                            Dim ext As String = &quot;.wav&quot;&#xA;                            If ct.Contains(&quot;mpeg&quot;) OrElse ct.Contains(&quot;mp3&quot;) Then ext = &quot;.mp3&quot;&#xA;                            If ct.Contains(&quot;mp4&quot;) OrElse ct.Contains(&quot;m4a&quot;) Then ext = &quot;.m4a&quot;&#xA;                            System.IO.Directory.CreateDirectory(tempFolder)&#xA;                            audioPath = System.IO.Path.Combine(tempFolder, callId + ext)&#xA;                            System.IO.File.WriteAllBytes(audioPath, ar.Content.ReadAsByteArrayAsync().GetAwaiter().GetResult())&#xA;                            message = &quot;&quot;&#xA;                            Exit For&#xA;                        End If&#xA;                        message = &quot;AUDIO_FAILED: &quot; + CInt(ar.StatusCode).ToString()&#xA;                        System.Threading.Thread.Sleep(5000)&#xA;                    Next&#xA;                End If&#xA;            End If&#xA;        End If&#xA;    End Using&#xA;Catch ex As Exception&#xA;    message = &quot;HTTP_ERROR: &quot; + ex.GetType().Name + &quot; &quot; + ex.Message&#xA;End Try&#xA;" DisplayName="Invoke Code: 대기 통화 가져가기 (API 2, 12, 10)" sap:VirtualizedContainerService.HintSize="450,394" sap2010:WorkflowViewState.IdRef="InvokeCode_1">
